# Build outputs
dist/
build/
out/

# Node dependencies
node_modules/

# Vercel and deployment
.vercel/
.vercel

# Environment files
.env
.env.*

# System files
.DS_Store
Thumbs.db

# IDE/workspace config
.vscode/
.idea/
*.swp
*.swo

# Cache and temporary files
.cache/
.cache/*
*.log
npm-debug.log*
yarn-debug.log*
